# scripts/ が読む環境変数の名前だけ（値は空のまま・ここに値を書かない）。
# どれも任意＝空なら既定の場所を使う。scripts は .env を読まないので、使うときはシェルで export する。

# 器の根（既定: このリポの根）— build_scope_progress.py・build_agent_aliases.py
MIKOTO_OS_ROOT=
# 時計の控えの置き場（既定: ~/.claude/routine・~/.claude/scheduler）— build_scope_progress.py
ROUTINE_DIR=
SCHEDULER_DIR=
# 時計の控えを 1 本に絞るとき — build_agent_aliases.py
SCHEDULER_STATE=
# CTO のリポの根（既定: 無し＝測定不能として扱う）— kiroku.py
KIROKU_CTO_ROOT=

# kit-ingest/fetch_one.py・inventory_youtube.py の --cookie-env には「Cookie を入れた変数の名前」を渡す。
# 変数名は使う人が決める（ここには書かない）。
