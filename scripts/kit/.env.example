# scripts/ が読む環境変数の名前だけ（値は空のまま・ここに値を書かない）。
# どれも任意＝空なら既定の場所を使う。scripts は .env を読まないので、使うときはシェルで export する。

# 器の根（既定: このリポの根）— build_scope_progress.py・build_agent_aliases.py
MIKOTO_OS_ROOT=
# 時計の控えの置き場（既定: ~/.claude/routine。SCHEDULER_DIR は皆伝の機体だけの時計の控え）— build_scope_progress.py
ROUTINE_DIR=
SCHEDULER_DIR=
# 時計の控えを 1 本に絞るとき — build_agent_aliases.py
SCHEDULER_STATE=
# CTO のリポの根（既定: 無し＝測定不能として扱う）— kiroku.py
KIROKU_CTO_ROOT=

# kit-ingest/fetch_one.py・inventory_youtube.py の --cookie-env には「Cookie を入れた変数の名前」を渡す。
# 変数名は使う人が決める（ここには書かない）。

# 本陣の形（器の版: 本陣-1）の道具。どれも任意＝空なら既定を使う
# プロジェクト欄の帳面の置き場（既定: BlueLamp の拡張が持つ帳面）— honjin.py ledger
HONJIN_PROJECTS_JSON=
# 席ごとの作業場所（皆伝の機体だけ）— scripts/皆伝/honjin_wt.py
#   対象の本陣（既定: 道具の置き場から引く）／作業木の置き場（既定: 中の OS の 11一時ファイル/作業場）／1 で作業木を丸ごと切る
HONJIN_ROOT=
HONJIN_WT_DIR=
HONJIN_WT_FULL=
